# Agave Studio gateway keys. Copy to config/keys.env (gitignored, chmod 600) or set the same
# names as environment variables. Leave a value empty to leave that provider off.
# Never commit real values. POST /api/keys accepts only the names listed here.

# fal.ai queue API: Kling, Seedance, Wan, Hailuo, Veo, FLUX, Nano Banana, Seedream
# Docs: https://fal.ai/docs/model-apis/model-endpoints/queue
FAL_KEY=

# Replicate predictions API (Bearer token)
# Docs: https://replicate.com/docs/reference/http
REPLICATE_API_TOKEN=

# Google Gemini API: Veo 3.1 video and Gemini image models (x-goog-api-key)
# Docs: https://ai.google.dev/gemini-api/docs/veo
GEMINI_API_KEY=

# OpenAI images (gpt-image)
# Docs: https://developers.openai.com/api/docs/guides/image-generation
OPENAI_API_KEY=

# Black Forest Labs FLUX (x-key header)
# Docs: https://docs.bfl.ai/quick_start/generating_images
BFL_API_KEY=

# ElevenLabs text to speech (xi-api-key header)
# Docs: https://elevenlabs.io/docs/api-reference/text-to-speech/convert
ELEVENLABS_API_KEY=

# Meshy 3D: image or multi-image to 3D (Bearer key)
# Docs: https://docs.meshy.ai/en/api/image-to-3d
MESHY_API_KEY=

# Not a key: the address of your own ComfyUI, served through comfy-api-proxy (Comfy API v2). Runs open-weights
# models (LTX-Video, FLUX.1 schnell) on your own GPU at no cost. Empty means http://127.0.0.1:8189, the proxy's
# default. http or https only.
# Docs: https://docs.comfy.org/development/comfyui-server/api-proxy
COMFY_BASE_URL=
